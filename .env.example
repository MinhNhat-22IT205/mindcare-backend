# MindCare AI Risk Engine v2.0 - Environment Configuration
DJANGO_SECRET_KEY=mindcare-dev-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Field-level AES-256-GCM encryption key (any strong passphrase; hashed via SHA-256 into 32 bytes)
FIELD_ENCRYPTION_KEY=mindcare-aes256-gcm-dev-passphrase-change-in-prod

# Dual-Mode Gemini API configuration (optional: leave blank for deterministic Vietnamese heuristic mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
